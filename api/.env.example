# Aplicación
APP_NAME="Sistema de Trazabilidad Documental"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# MySQL local (XAMPP). Crea esta base de datos en phpMyAdmin antes de conectar.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sistema_trazabilidad
DB_USER=root
DB_PASSWORD=

# Configuración reservada para la etapa de autenticación; reemplazar antes de usar JWT.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256

# Ruta local para archivos; no se utiliza hasta implementar la carga documental.
STORAGE_PATH=storage
