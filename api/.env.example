# Aplicación
APP_NAME="Sistema de Trazabilidad Documental"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# MySQL local (XAMPP). Crea esta base de datos en phpMyAdmin antes de conectar.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sistema_trazabilidad
DB_USER=root
DB_PASSWORD=

# Obligatorio: reemplazar el marcador por un secreto CSPRNG privado antes de iniciar FastAPI.
# Configuración insegura/default impide startup. HS256: mínimo 32 bytes (HS384: 48; HS512: 64).
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256

# 6B.4A: protección local; presupuesto global válido para UN SOLO proceso API.
RATE_LIMIT_LOGIN_REQUESTS_PER_MINUTE=120
RATE_LIMIT_IDENTIFIER_REQUESTS_PER_MINUTE=10
RATE_LIMIT_FAILURE_WINDOW_SECONDS=600
# Hard limit: rechaza con 429 hasta vencer la ventana, incluso con Turnstile valido.
RATE_LIMIT_CHALLENGE_FAILURES=5
RATE_LIMIT_ARGON2_PER_MINUTE=60
RATE_LIMIT_ARGON2_CONCURRENCY=2

# 6B.4B: segunda capa adaptativa. Disabled es una decision explicita y requiere
# reinicio; pierde la capa anti-bot, conservando todos los limites 6B.4A/6C.
# enabled: secreto privado real + hostnames EXACTOS del frontend obligatorios.
# test: solo claves dummy oficiales de Cloudflare, nunca permitido en production.
# No hay secretos productivos predeterminados. Site key publica: solo PHP.
TURNSTILE_MODE=disabled
TURNSTILE_SECRET_KEY=
# Lista separada por comas, sin esquema/puerto/ruta/wildcards. Ejemplo local test:
# TURNSTILE_EXPECTED_HOSTNAMES=localhost,127.0.0.1
TURNSTILE_EXPECTED_HOSTNAMES=
TURNSTILE_VERIFY_TIMEOUT_SECONDS=5
# Cuenta cada POST externo, incluido el unico retry transitorio.
TURNSTILE_VERIFY_GLOBAL_PER_MINUTE=60
TURNSTILE_VERIFY_CONCURRENCY=4

# 6C: límites separados de login, UN SOLO proceso API, sin excepciones por rol.
RESET_REQUEST_PER_HOUR=3
RESET_REQUEST_GLOBAL_PER_MINUTE=20
ACCESS_REQUEST_PER_DAY=2
ACCESS_REQUEST_GLOBAL_PER_MINUTE=10
ACTION_CONFIRM_PER_MINUTE=5
ACTION_CONFIRM_GLOBAL_PER_MINUTE=30
ACTION_HASH_PER_MINUTE=5

# Correo privado, procesado únicamente por scripts/procesar_correo_auth.py.
# Completar antes de habilitar recuperación/aprobaciones. No usar datos reales en tests.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME="Sistema de Trazabilidad"
SMTP_TIMEOUT_SECONDS=5
# URL fija del directorio frontend; HTTPS salvo loopback en development. Sin query/fragment.
PUBLIC_FRONTEND_URL=
PASSWORD_RESET_TTL_SECONDS=1800

# Generar localmente con CSPRNG: python -c "import secrets; print(secrets.token_hex(32))"
# Para HS384 usar token_hex(48); para HS512 token_hex(64).
# token_urlsafe(32/48/64) también es válido. Los tamaños indican bytes aleatorios
# antes de codificar; la validación de longitud no demuestra entropía.
# Guardar el resultado en JWT_SECRET_KEY de .env privado; nunca subirlo a Git.

# Ruta local para archivos; no se utiliza hasta implementar la carga documental.
STORAGE_PATH=storage
